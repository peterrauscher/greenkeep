# Copy to .env.production. Never commit the populated file.
# Generate the three random secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-hex-secret
BETTER_AUTH_SECRET=replace-with-a-different-random-hex-secret
BETTER_AUTH_URL=https://greenkeep.xyz
GITHUB_CLIENT_ID=replace-with-your-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-client-secret
VITE_AUTH_ENABLED=true

# RevenueCat Web Billing: public browser key plus a server-only secret key.
# Create `pro` (lifetime) and `premium` (monthly) entitlements.
VITE_REVENUECAT_WEB_API_KEY=rcb_replace-with-your-public-web-api-key
REVENUECAT_SECRET_API_KEY=sk_replace-with-your-secret-api-key
SYNC_WORKER_SECRET=replace-with-another-random-hex-secret

CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-token-from-cloudflare-zero-trust

